---
import Container from "@/layouts/Container.astro";
import LogoSVG from "@/components/svgs/LogoSVG.astro";

import { navlinks, type Navlink } from "@/lib/data/navlinks";
---

<header class="py-4">
  <Container class="flex items-center justify-between gap-4">
    <a href="/" aria-label="Tech Conference Home"><LogoSVG /></a>

    <nav class="text-white">
      <ul class="flex items-center gap-4">
        {
          navlinks.map((link) => (
            <li>
              <a href={`/${link}`}>{link}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
