---
import Container from "@/layouts/Container.astro";
import LogoSVG from "@/components/svgs/LogoSVG.astro";

import { navlinks } from "@/lib/data/navlinks";
import MobileMenu from "@/components/client/MobileMenu";
import Button from "@/components/ui/Button";

const pathName = Astro.url.pathname;
---

<header class="px-4">
  <Container
    class="flex items-center justify-between gap-4 preset-6-medium text-white py-6 border-b border-neutral-600"
  >
    <a href="/" aria-label="Tech Conference Home"><LogoSVG /></a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-4">
        {
          navlinks.map((link) => (
            <li>
              <Button
                variant="nav"
                aria-current={pathName === link.href ? "page" : undefined}
                href={link.href}
                className=""
                size="sm"
              >
                {link.label}
              </Button>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:hidden">
      <MobileMenu client:load pathName={pathName} />
    </div>
  </Container>
</header>
