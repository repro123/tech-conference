---
import type { Talk } from "@lib/types/talk";
import type { Track } from "@lib/types/track";
import type { Speaker } from "@lib/types/speaker";

import Barcode from "@assets/images/pattern-barcode.svg";
import { Plus, Minus } from "@lucide/astro";
import AddToMySchedule from "@components/client/AddToMySchedule";

interface Props {
  talks: Talk[];
  tracks: Track[];
  speakers: Speaker[];
  isSchedulePage?: boolean;
}

const { talks, tracks, speakers, isSchedulePage = false } = Astro.props;
---

<ul class="mt-6 grid gap-4">
  {
    talks.map((talk) => {
      const track = tracks.find((track) => track.id === talk.trackId);
      const speaker = speakers.find((speaker) => speaker.id === talk.speakerId);
      const trackLabel = track?.name.toLowerCase() === "accessibility" ? "a11y" : track?.name;

      return (
        <li data-talk-card data-day={talk.day} data-track={trackLabel?.toLowerCase()} data-talk-id={talk.id}>
          <div class="border mt-4 flex flex-col md:flex-row" style={{ borderColor: track?.color }}>
            <div class="text-center flex items-center justify-center p-1 md:w-8">
              <span class="uppercase preset-6-medium md:-rotate-90" style={{ color: track?.color }}>
                {track?.name}
              </span>
            </div>

            <div
              class="text-neutral-900 flex flex-col md:flex-row md:items-center w-full"
              style={{ backgroundColor: track?.color }}
            >
              <div class="p-4 w-full">
                <p class="preset-2-mobile md:preset-2 lowercase">{talk?.title}</p>

                <div class="flex items-center gap-2 preset-5 uppercase mt-4">
                  <p class="preset-5-bold">{speaker?.name}</p>
                  <span>//</span>
                  <p>{speaker?.company}</p>
                </div>

                <div class="grid gap-2 text-neutral-900">
                  <div
                    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-450 data-open:grid-rows-[1fr]"
                    id={`details-${talk.id}`}
                    data-details
                  >
                    <div class="overflow-hidden">
                      <div class="grid gap-2 border-t border-t-neutral-500 pt-4 mt-4">
                        <p class="preset-6">{talk?.description}</p>
                        <p class="preset-6-medium uppercase">location: {talk?.location}</p>
                      </div>
                    </div>
                  </div>

                  <button
                    class="preset-7 text-neutral-600 hover:text-neutral-900 hover:underline flex items-center gap-1 w-fit uppercase"
                    type="button"
                    data-toggle-details
                    aria-expanded="false"
                    aria-controls={`details-${talk.id}`}
                  >
                    <Plus class="size-4" data-icon-plus />
                    <Minus class="hidden size-4" data-icon-minus /> <span data-label>show details</span>
                  </button>
                </div>
              </div>

              <div class="border-t md:border-t-0 md:border-l border-dashed border-neutral-900 p-4 flex md:flex-col items-center justify-between md:justify-center gap-4 h-full">
                <div class="flex flex-col items-center">
                  <span aria-label="start time" class="preset-4">
                    {talk?.startTime}
                  </span>
                  <span aria-label="end time" class="preset-7">
                    {talk?.endTime}
                  </span>
                </div>

                <div>
                  <img src={Barcode.src} alt="" />
                </div>

                <div>
                  <p class="uppercase preset-7">day {talk?.day}</p>
                </div>

                {isSchedulePage && track && <AddToMySchedule talkId={talk.id} trackColor={track.color} client:load />}
              </div>
            </div>
          </div>
        </li>
      );
    })
  }
</ul>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-toggle-details]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const panel = document.getElementById(btn.getAttribute("aria-controls")!);
        if (!panel) return;

        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!expanded));
        panel.toggleAttribute("data-open", !expanded);

        btn.querySelector("[data-icon-plus]")?.classList.toggle("hidden", !expanded);
        btn.querySelector("[data-icon-minus]")?.classList.toggle("hidden", expanded);
        btn.querySelector("[data-label]")!.textContent = expanded ? "show details" : "hide details";
      });
    });
  });
</script>
