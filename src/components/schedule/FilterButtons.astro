---
import Container from "@layouts/Container.astro";
import Button from "@components/ui/Button";

import ConferenceData from "@lib/data/data.json";
const talks = ConferenceData.talks;
const tracks = ConferenceData.tracks;

const days = [...new Set(talks.map((talk) => talk.day))].sort((a, b) => a - b);
const trackLabels = [...new Set(tracks.map((track) => track.name))];
---

<Container>
  <div class="flex items-center gap-4 flex-wrap" id="schedule-filters" role="group" aria-label="Filter talks">
    {
      days.map((day) => (
        <Button
          variant="accent"
          size="sm"
          data-filter-day
          type="button"
          className="preset-6-medium"
          value={day}
          aria-pressed="false"
        >
          day {day}
        </Button>
      ))
    }
    <span aria-hidden="true" class="self-stretch border-l border-neutral-100"></span>
    {
      trackLabels.map((track) => {
        const label = track.toLowerCase() === "accessibility" ? "a11y" : track;
        return (
          <Button
            variant="accent"
            size="sm"
            data-filter-track
            type="button"
            className="preset-6-medium rounded-full"
            value={label.toLowerCase()}
            aria-pressed="false"
          >
            {label}
          </Button>
        );
      })
    }
    <Button
      variant="schedule"
      size="sm"
      data-filter-saved
      type="button"
      className="preset-6-medium rounded-full border-dashed"
      value="saved"
      aria-pressed="false"
    >
      my schedule
    </Button>
    <Button variant="clear" size="sm" id="clear" type="button" className="preset-6-medium rounded-full"> clear </Button>
  </div>
</Container>

<script>
  document.addEventListener("astro:page-load", () => {
    const params = new URLSearchParams(window.location.search);

    const dayFilterBtns = document.querySelectorAll("[data-filter-day]") as NodeListOf<HTMLButtonElement>;
    const trackFilterBtns = document.querySelectorAll("[data-filter-track]") as NodeListOf<HTMLButtonElement>;
    const savedBtn = document.querySelector<HTMLButtonElement>("[data-filter-saved]");
    const clearBtn = document.getElementById("clear") as HTMLButtonElement | null;

    if (dayFilterBtns) {
      dayFilterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const url = new URL(window.location.href);
          url.searchParams.set("day", btn.value);
          updateUrl(url);
        });
      });
    }

    if (trackFilterBtns) {
      trackFilterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const url = new URL(window.location.href);
          const currentTrack = url.searchParams.get("track");

          if (currentTrack === btn.value) {
            url.searchParams.delete("track");
          } else {
            url.searchParams.set("track", btn.value);
          }

          updateUrl(url);
        });
      });
    }

    savedBtn?.addEventListener("click", () => {
      const url = new URL(window.location.href);
      const isSaved = url.searchParams.get("saved") === "true";

      if (isSaved) {
        url.searchParams.delete("saved");
      } else {
        url.searchParams.set("saved", "true");
      }

      updateUrl(url);
    });

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        const url = new URL(window.location.href);
        url.search = "";
        updateUrl(url);
      });
    }

    syncFilters();

    function updateUrl(url: URL) {
      history.pushState({}, "", url);

      syncFilters();

      window.dispatchEvent(new CustomEvent("schedule-filters-change"));
    }

    function syncFilters() {
      const params = new URLSearchParams(window.location.search);

      const day = params.get("day") ?? "1";
      const track = params.get("track");
      const saved = params.get("saved") === "true";

      dayFilterBtns.forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.value === day));
      });

      trackFilterBtns.forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.value === track));
      });

      savedBtn?.setAttribute("aria-pressed", String(saved));
    }
  });
</script>
