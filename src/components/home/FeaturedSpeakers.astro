---
import Container from "@/layouts/Container.astro";
import SecondaryHeading from "@/components/ui/SecondaryHeading.astro";
import Button from "@/components/ui/Button";

import SpeakersCards from "@components/speakers-page/SpeakersCards.astro";

import { getSpeakers } from "@/lib/sanity/speakers";
import { getTracks } from "@/lib/sanity/tracks";
import { getTalks } from "@/lib/sanity/talks";

const tracks = await getTracks();
const allSpeakers = await getSpeakers();
const featuredSpeakers = allSpeakers.filter((speaker) => speaker.featured);
const talks = await getTalks();
---

<section>
  <Container>
    <SecondaryHeading text="featured_speakers" class="text-green preset-6-extrabold" />

    <SpeakersCards speakers={featuredSpeakers} talks={talks} tracks={tracks} />

    <div class="mt-6 flex justify-center">
      <Button href="/speakers" variant="primary" className="preset-5-bold w-fit">View all speakers</Button>
    </div>
  </Container>
</section>
