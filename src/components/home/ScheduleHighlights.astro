---
import Container from "@/layouts/Container.astro";
import SecondaryHeading from "@/components/ui/SecondaryHeading.astro";
import Button from "@/components/ui/Button";
import ScheduleCards from "@components/schedule/ScheduleCards.astro";

import { getSpeakers } from "@/lib/sanity/speakers";
import { getTracks } from "@/lib/sanity/tracks";
import { getTalks } from "@/lib/sanity/talks";

const [tracks, allTalks, speakers] = await Promise.all([getTracks(), getTalks(), getSpeakers()]);

const talks = allTalks.filter((talk) => talk.highlighted);
---

<section>
  <Container>
    <SecondaryHeading text="schedule_highlights" class="text-green preset-6-extrabold" />

    <ScheduleCards talks={talks} tracks={tracks} speakers={speakers} />

    <div class="mt-6 flex justify-center">
      <Button href="/schedule" variant="primary" className="preset-5-bold w-fit">View full schedule</Button>
    </div>
  </Container>
</section>
