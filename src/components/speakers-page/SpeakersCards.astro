---
import type { Track, Talk, Speaker } from "@lib/sanity/types";
import { Image } from "astro:assets";
import { urlFor } from "@lib/sanity/image";

import AvatarBG from "@assets/images/pattern-avatar-bg.svg";

import OpenSpeakerModal from "@components/client/OpenSpeakerModal";

interface Props {
  speakers: Speaker[];
  talks: Talk[];
  tracks: Track[];
}

const { speakers, talks, tracks } = Astro.props;
---

<ul class="mt-6 grid justify-items-center gap-6 sm:grid-cols-2 sm:justify-items-stretch lg:grid-cols-4">
  {
    speakers.map((speaker) => {
      const talk = talks.find((talk) => talk?.speaker?._ref === speaker.id);
      const track = tracks.find((track) => track.id === talk?.track?._ref);
      const speakerAvatar = speaker?.avatar && urlFor(speaker.avatar).width(800).auto("format").url();
      return (
        <li class="preset-6-medium w-full border border-neutral-600 flex flex-col relative hover:border-neutral-100 shadow-[2px_2px_0] shadow-neutral-900 hover:shadow-neutral-100 hover:shadow-[2px_2px_0] has-focus-within:shadow-neutral-100 has-focus-within:border-neutral-100 group transition-all duration-450">
          <div class="relative aspect-4/3 overflow-hidden sm:aspect-square" style={{ backgroundColor: track?.color }}>
            <Image src={AvatarBG} alt="" class="absolute inset-0 size-full object-cover" />

            <img
              alt=""
              src={speakerAvatar}
              class="relative size-full object-cover max-w-full group-hover:scale-110 transition-all duration-450"
              loading="lazy"
            />
          </div>

          <div class="flex flex-1 flex-col p-4">
            <h3>{talk && track && <OpenSpeakerModal speaker={speaker} talk={talk} track={track} client:load />}</h3>
            <p class="text-neutral-200 my-4">
              {speaker.role} @ {speaker.company}
            </p>

            <div class="border-t border-neutral-600 mt-auto pt-4">
              {talk && <p class="text-green uppercase">{talk.title}</p>}
            </div>
          </div>
        </li>
      );
    })
  }
</ul>
