---
import Container from "@/layouts/Container.astro";
import SecondaryHeading from "@/components/ui/SecondaryHeading.astro";

import SpeakersCards from "@components/speakers-page/SpeakersCards.astro";

import { getSpeakers } from "@/lib/sanity/speakers";
import { getTracks } from "@/lib/sanity/tracks";
import { getTalks } from "@/lib/sanity/talks";

const [tracks, talks, speakers] = await Promise.all([getTracks(), getTalks(), getSpeakers()]);
---

<section>
  <Container>
    <h1 class="sr-only">Conference Speakers</h1>
    <SecondaryHeading text="speakers" class="text-green preset-6-extrabold" />

    <SpeakersCards speakers={speakers} talks={talks} tracks={tracks} />
  </Container>
</section>
