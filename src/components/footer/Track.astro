---
import SecondaryHeading from "@/components/ui/SecondaryHeading.astro";
import { tracks } from "@/lib/data/tracks";
---

<div>
  <SecondaryHeading text="tracks" class="text-green preset-6-medium" />

  <ul class="mt-6 flex flex-col gap-4">
    {
      tracks.map((track) => (
        <li>
          <a href={track.href} class="capitalize hover:text-green">
            {track.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
