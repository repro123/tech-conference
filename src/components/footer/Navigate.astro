---
import SecondaryHeading from "@/components/ui/SecondaryHeading.astro";
import { navlinks } from "@/lib/data/navlinks";
---

<div>
  <SecondaryHeading text="navigate" class="text-green preset-6-medium" />

  <ul class="mt-6 flex flex-col gap-4">
    {
      navlinks.map((link) => (
        <li>
          <a href={link.href} class="capitalize hover:text-green">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
